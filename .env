# Copy this file to .env and fill in your Firebase project values.
# These are used only for values NOT already covered by
# google-services.json (Android) / GoogleService-Info.plist (iOS),
# e.g. web API keys for any REST calls, or feature flags.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID_ANDROID=1:1234567890:android:abcdef
FIREBASE_APP_ID_IOS=1:1234567890:ios:abcdef

# App-level
APP_ENV=development
